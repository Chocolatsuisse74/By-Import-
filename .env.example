# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/by_import
DATABASE_POOL_SIZE=20

# File Upload Configuration
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# Processing Configuration
BATCH_SIZE=1000
MAX_RETRIES=3
TIMEOUT_MS=300000

# AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ENABLE_AI_VALIDATION=true
ENABLE_AI_TRANSFORMATION=true

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_WEBHOOKS=true
ENABLE_SCHEDULING=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.example.com

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Webhooks Configuration
WEBHOOK_MAX_RETRIES=5
WEBHOOK_BASE_DELAY_MS=1000
WEBHOOK_MAX_DELAY_MS=60000
